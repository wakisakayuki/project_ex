<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク削除完了 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク削除完了</h1><% if(request.getAttribute("deletedTasks")==null){ request.setAttribute("message",util.WebSupport.message("E013")); %><p class="message"><ui:e value="${message}"/></p><% } else { %><p class="message success"><ui:e value="${message}"/></p><table><tr><th>削除したタスク</th><th>期限</th></tr><% for(model.entity.TaskBean t:(java.util.List<model.entity.TaskBean>)request.getAttribute("deletedTasks")){ %><tr><td><ui:e value="<%=t.getTaskName()%>"/></td><td><ui:e value="<%=t.getLimitDate()%>"/></td></tr><% } %></table><% } %><a class="button" href="${pageContext.request.contextPath}/menu">メニュー画面へ</a></main><footer>タスク管理システム</footer></body></html>