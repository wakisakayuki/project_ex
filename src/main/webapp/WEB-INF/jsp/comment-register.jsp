<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>コメント投稿 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>コメント投稿</h1><% if(request.getAttribute("message")!=null){ %><p class="message"><ui:e value="${message}"/></p><% } model.entity.TaskBean t=(model.entity.TaskBean)request.getAttribute("task"); %><% if(t!=null){ %><p>タスク：<strong><ui:e value="<%=t.getTaskName()%>"/></strong></p><form method="post" action="${pageContext.request.contextPath}/comment-register-result-servlet"><input type="hidden" name="task_id" value="<%=t.getTaskId()%>"><label>コメント（100文字以内）</label><textarea name="comment" maxlength="100" required><ui:e value="${comment}"/></textarea><button>投稿</button></form><form method="post" action="${pageContext.request.contextPath}/task-detail-servlet"><input type="hidden" name="task_id" value="<%=t.getTaskId()%>"><button class="secondary">詳細へ戻る</button></form><% } %></main><footer>タスク管理システム</footer></body></html>