<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク登録 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク登録</h1><% if(request.getAttribute("message")!=null){ %><p class="message"><ui:e value="${message}"/></p><% } %><form method="post" action="${pageContext.request.contextPath}/task-register-result-servlet"><label>タスク名（50文字以内）</label><input name="taskName" maxlength="50" required value="<ui:e value='${task.taskName}'/>"><div class="row"><div><label>カテゴリ</label><select name="categoryId" required><option value="">選択してください</option><% for(model.entity.CategoryBean c:(java.util.List<model.entity.CategoryBean>)request.getAttribute("categories")){ %><option value="<%=c.getCategoryId()%>" <%= request.getAttribute("task")!=null && ((model.entity.TaskBean)request.getAttribute("task")).getCategoryId()==c.getCategoryId()?"selected":"" %>><ui:e value="<%=c.getCategoryName()%>"/></option><% } %></select></div><div><label>期限（任意）</label><input type="date" name="limitDate" value="<ui:e value='${task.limitDate}'/>"></div><div><label>担当者</label><select name="userId" required><option value="">選択してください</option><% for(model.entity.UserBean u:(java.util.List<model.entity.UserBean>)request.getAttribute("users")){ %><option value="<ui:e value='<%=u.getUserId()%>'/>" <%= request.getAttribute("task")!=null && u.getUserId().equals(((model.entity.TaskBean)request.getAttribute("task")).getUserId())?"selected":"" %>><ui:e value="<%=u.getUserName()%>"/></option><% } %></select></div><div><label>ステータス</label><select name="statusCode" required><option value="">選択してください</option><% for(model.entity.StatusBean s:(java.util.List<model.entity.StatusBean>)request.getAttribute("statuses")){ %><option value="<ui:e value='<%=s.getStatusCode()%>'/>" <%= request.getAttribute("task")!=null && s.getStatusCode().equals(((model.entity.TaskBean)request.getAttribute("task")).getStatusCode())?"selected":"" %>><ui:e value="<%=s.getStatusName()%>"/></option><% } %></select></div></div><label>メモ（100文字以内・任意）</label><textarea name="memo" maxlength="100"><ui:e value="${task.memo}"/></textarea><button type="submit">登録</button><button type="reset" class="secondary">クリア</button><a class="button secondary" href="${pageContext.request.contextPath}/menu">メニューへ戻る</a></form></main><footer>タスク管理システム</footer></body></html>