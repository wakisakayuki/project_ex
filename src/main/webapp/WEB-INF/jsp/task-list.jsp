<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク一覧 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク一覧</h1><% if(request.getAttribute("message")!=null){ %><p class="message"><ui:e value="${message}"/></p><% } %><% java.util.List<model.entity.TaskBean> tasks=(java.util.List<model.entity.TaskBean>)request.getAttribute("tasks"); %><p>タスク件数：<%=tasks==null?0:tasks.size()%></p><% if(tasks==null||tasks.isEmpty()){ %><p class="muted">タスクはありません。</p><% } else { %><form method="post" action="${pageContext.request.contextPath}/task-delete-confirm-servlet"><table><thead><tr><th>削除</th><th>タスク名</th><th>カテゴリ</th><th>期限</th><th>担当者</th><th>状態</th><th>メモ</th></tr></thead><tbody><% for(model.entity.TaskBean t:tasks){ %><tr><td><input type="checkbox" name="task_ids" value="<%=t.getTaskId()%>" aria-label="タスク<%=t.getTaskId()%>を削除対象にする"></td><td><button class="linklike" type="submit" formaction="${pageContext.request.contextPath}/task-detail-servlet" name="task_id" value="<%=t.getTaskId()%>"><ui:e value="<%=t.getTaskName()%>"/></button></td><td><ui:e value="<%=t.getCategoryName()%>"/></td><td><ui:e value="<%=t.getLimitDate()%>"/></td><td><ui:e value="<%=t.getUserName()%>"/></td><td><ui:e value="<%=t.getStatusName()%>"/></td><td><ui:e value="<%=t.getMemo()%>"/></td></tr><% } %></tbody></table><button type="submit" class="danger">削除対象を確認</button></form><% } %><a class="button secondary" href="${pageContext.request.contextPath}/menu">メニューへ</a></main><footer>タスク管理システム</footer></body></html>