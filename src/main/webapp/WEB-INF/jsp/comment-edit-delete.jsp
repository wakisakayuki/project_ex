<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>コメント編集・削除 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>コメント編集・削除</h1><% if(request.getAttribute("message")!=null){ %><p class="message"><ui:e value="${message}"/></p><% } model.entity.CommentBean c=(model.entity.CommentBean)request.getAttribute("comment"); %><p>投稿日時：<ui:e value="<%=c.getUpdateDateTime()%>"/></p><form method="post" action="${pageContext.request.contextPath}/comment-edit-result-servlet"><input type="hidden" name="comment_id" value="<%=c.getCommentId()%>"><label>コメント本文（100文字以内）</label><textarea name="comment" maxlength="100" required><ui:e value="<%=request.getAttribute("commentValue")!=null?request.getAttribute("commentValue"):c.getComment()%>"/></textarea><button>編集</button></form><form method="post" action="${pageContext.request.contextPath}/comment-delete-result-servlet" onsubmit="return confirm('コメントを削除しますか？');"><input type="hidden" name="comment_id" value="<%=c.getCommentId()%>"><button class="danger">削除</button></form><form method="get" action="${pageContext.request.contextPath}/task-detail-servlet"><input type="hidden" name="task_id" value="<%=c.getTaskId()%>"><button class="secondary">戻る</button></form></main><footer>タスク管理システム</footer></body></html>