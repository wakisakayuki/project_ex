<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク削除確認 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク削除確認</h1><p class="message"><ui:e value="${message}"/></p><form method="post" action="${pageContext.request.contextPath}/task-delete-result-servlet"><p>次のタスクと関連コメントを削除します。</p><table><tr><th>タスク名</th><th>期限</th><th>カテゴリ</th></tr><% for(model.entity.TaskBean t:(java.util.List<model.entity.TaskBean>)request.getAttribute("tasks")){ %><tr><td><ui:e value="<%=t.getTaskName()%>"/></td><td><ui:e value="<%=t.getLimitDate()%>"/></td><td><ui:e value="<%=t.getCategoryName()%>"/></td></tr><input type="hidden" name="task_ids" value="<%=t.getTaskId()%>"><% } %></table><button class="danger">実行</button></form><a class="button secondary" href="${pageContext.request.contextPath}/task-list">戻る</a></main><footer>タスク管理システム</footer></body></html>