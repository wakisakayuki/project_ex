<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク詳細 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク詳細</h1><% if(request.getAttribute("message")!=null){ %><p class="message"><ui:e value="${message}"/></p><% } model.entity.TaskBean t=(model.entity.TaskBean)request.getAttribute("task"); if(t!=null){ %><table><tr><th>タスク名</th><td><ui:e value="<%=t.getTaskName()%>"/></td></tr><tr><th>カテゴリ</th><td><ui:e value="<%=t.getCategoryName()%>"/></td></tr><tr><th>期限</th><td><ui:e value="<%=t.getLimitDate()%>"/></td></tr><tr><th>担当者</th><td><ui:e value="<%=t.getUserName()%>"/></td></tr><tr><th>ステータス</th><td><ui:e value="<%=t.getStatusName()%>"/></td></tr><tr><th>メモ</th><td><ui:e value="<%=t.getMemo()%>"/></td></tr><tr><th>登録日時</th><td><ui:e value="<%=t.getCreateDateTime()%>"/></td></tr><tr><th>更新日時</th><td><ui:e value="<%=t.getUpdateDateTime()%>"/></td></tr></table><div class="row"><form method="post" action="${pageContext.request.contextPath}/comment-register-servlet"><input type="hidden" name="task_id" value="<%=t.getTaskId()%>"><button>コメントを投稿</button></form><% if(Boolean.TRUE.equals(request.getAttribute("isTaskOwner"))){ %><form method="post" action="${pageContext.request.contextPath}/task-edit-servlet"><input type="hidden" name="task_id" value="<%=t.getTaskId()%>"><button>タスクを編集</button></form><% } %></div><h2>コメント</h2><% java.util.List<model.entity.CommentBean> comments=(java.util.List<model.entity.CommentBean>)request.getAttribute("comments"); if(comments==null||comments.isEmpty()){ %><p class="muted">コメントはありません。</p><% } else { for(model.entity.CommentBean c:comments){ %><article><p><strong><ui:e value="<%=c.getUserName()%>"/></strong>　<ui:e value="<%=c.getUpdateDateTime()%>"/></p><p><ui:e value="<%=c.getComment()%>"/></p><% if(c.getUserId().equals(request.getAttribute("currentUserId"))){ %><form method="post" action="${pageContext.request.contextPath}/comment-edit-delete-servlet"><input type="hidden" name="comment_id" value="<%=c.getCommentId()%>"><button class="secondary">編集・削除</button></form><% } %></article><hr><% } } } %><a class="button secondary" href="${pageContext.request.contextPath}/task-list">一覧へ戻る</a></main><footer>タスク管理システム</footer></body></html>