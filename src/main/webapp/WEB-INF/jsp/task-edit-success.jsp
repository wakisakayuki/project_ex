<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク編集完了 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク編集完了</h1><p class="message success"><ui:e value="${message}"/></p><% model.entity.TaskBean t=(model.entity.TaskBean)request.getAttribute("task"); %><p>タスク「<ui:e value="<%=t==null?"":t.getTaskName()%>"/>」を更新しました。</p><a class="button" href="${pageContext.request.contextPath}/menu">メニューへ</a><form method="post" action="${pageContext.request.contextPath}/task-detail-servlet"><input type="hidden" name="task_id" value="<%=t==null?0:t.getTaskId()%>"><button class="secondary">詳細を表示</button></form></main><footer>タスク管理システム</footer></body></html>