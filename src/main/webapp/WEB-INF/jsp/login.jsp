<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ログイン | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>ログイン</h1><% if(request.getAttribute("message")!=null){ %><p class="message"><ui:e value="${message}"/></p><% } %><form method="post" action="${pageContext.request.contextPath}/login-servlet"><label for="userId">ユーザID</label><input id="userId" name="userId" maxlength="24" required value="<ui:e value='${userId}'/>" autocomplete="username"><label for="password">パスワード</label><input id="password" name="password" type="password" maxlength="32" required autocomplete="current-password"><button type="submit">ログイン</button></form></main><footer>タスク管理システム</footer></body></html>