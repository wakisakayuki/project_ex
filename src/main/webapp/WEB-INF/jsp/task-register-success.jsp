<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク登録完了 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク登録完了</h1><p class="message success"><ui:e value="${message}"/></p><% model.entity.TaskBean t=(model.entity.TaskBean)request.getAttribute("task"); if(t!=null){ %><table><tr><th>タスク名</th><td><ui:e value="<%=t.getTaskName()%>"/></td></tr><tr><th>カテゴリ</th><td><ui:e value="<%=t.getCategoryName()%>"/></td></tr><tr><th>期限</th><td><ui:e value="<%=t.getLimitDate()%>"/></td></tr><tr><th>担当者</th><td><ui:e value="<%=t.getUserName()%>"/></td></tr><tr><th>ステータス</th><td><ui:e value="<%=t.getStatusName()%>"/></td></tr><tr><th>メモ</th><td><ui:e value="<%=t.getMemo()%>"/></td></tr></table><% } %><a class="button" href="${pageContext.request.contextPath}/menu">メニュー画面へ</a></main><footer>タスク管理システム</footer></body></html>