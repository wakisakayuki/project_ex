<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク編集 | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク編集</h1><% if(request.getAttribute("message")!=null){ %><p class="message"><ui:e value="${message}"/></p><% } model.entity.TaskBean t=(model.entity.TaskBean)request.getAttribute("task"); %><form method="post" action="${pageContext.request.contextPath}/task-edit-result-servlet"><input type="hidden" name="task_id" value="<%=t.getTaskId()%>"><label>タスク名</label><input name="taskName" maxlength="50" required value="<ui:e value="${task.taskName}"/>"><div class="row"><div><label>カテゴリ</label><select name="categoryId"><% for(model.entity.CategoryBean c:(java.util.List<model.entity.CategoryBean>)request.getAttribute("categories")){ %><option value="<%=c.getCategoryId()%>" <%=c.getCategoryId()==t.getCategoryId()?"selected":""%>><ui:e value="<%=c.getCategoryName()%>"/></option><% } %></select></div><div><label>期限</label><input type="date" name="limitDate" value="<ui:e value="${task.limitDate}"/>"></div><div><label>ステータス</label><select name="statusCode"><% for(model.entity.StatusBean s:(java.util.List<model.entity.StatusBean>)request.getAttribute("statuses")){ %><option value="<ui:e value='<%=s.getStatusCode()%>'/>" <%=s.getStatusCode().equals(t.getStatusCode())?"selected":""%>><ui:e value="<%=s.getStatusName()%>"/></option><% } %></select></div></div><label>メモ</label><textarea name="memo" maxlength="100"><ui:e value="${task.memo}"/></textarea><button>編集する</button></form><form method="post" action="${pageContext.request.contextPath}/task-detail-servlet"><input type="hidden" name="task_id" value="<%=t.getTaskId()%>"><button class="secondary">詳細へ戻る</button></form></main><footer>タスク管理システム</footer></body></html>