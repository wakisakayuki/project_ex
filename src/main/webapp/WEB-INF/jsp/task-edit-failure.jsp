<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タスク編集エラー | タスク管理システム</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><strong>タスク管理システム</strong><span><ui:e value="${sessionScope.user_name}"/></span></header><main><h1>タスク編集エラー</h1><p class="message"><ui:e value="${message}"/></p><% model.entity.TaskBean t=(model.entity.TaskBean)request.getAttribute("task"); if(t!=null&&t.getTaskId()>0){ %><form method="post" action="${pageContext.request.contextPath}/task-edit-servlet"><input type="hidden" name="returnToEdit" value="1"><input type="hidden" name="task_id" value="<%=t.getTaskId()%>"><input type="hidden" name="taskName" value="<ui:e value='<%=t.getTaskName()%>'/>"><input type="hidden" name="categoryId" value="<%=t.getCategoryId()%>"><input type="hidden" name="limitDate" value="<ui:e value='<%=t.getLimitDate()%>'/>"><input type="hidden" name="userId" value="<ui:e value='<%=t.getUserId()%>'/>"><input type="hidden" name="statusCode" value="<ui:e value='<%=t.getStatusCode()%>'/>"><input type="hidden" name="memo" value="<ui:e value='<%=t.getMemo()%>'/>"><button>編集画面へ戻る</button></form><% } %><a class="button secondary" href="${pageContext.request.contextPath}/task-list">一覧へ</a></main><footer>タスク管理システム</footer></body></html>